# 이 파일을 .env.local 로 복사해서 채운다. .env.local 은 커밋되지 않는다.
#
# DATABASE_URL 과 AUTH_PASSWORD_HASH 는 1주차부터, OPENAI_API_KEY 는 2주차부터 필요하다.

# Neon Postgres 연결 문자열
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# npm run hash:password 로 생성한다. 평문 비밀번호를 여기 넣지 말 것.
# 형식은 scrypt.N.r.p.salt.hash 다. 따옴표 없이 그대로 붙인다.
# ($ 를 쓰지 않는 이유: dotenv 가 $16384 를 변수 참조로 보고 지워버린다)
AUTH_PASSWORD_HASH=

# 'production' | 'preview' | 'local'
# 예산 캡이 이 값을 읽는다 (production 100회/일·$20/월, 그 외 10회/일·$0.50/월).
# 자유학습은 gpt-6-luna(대화)·gpt-6.1-terra(자료·피드백)를 쓴다 — 키 하나로 둘 다 부른다.
APP_ENV=local

# 2주차부터 필요하다. lib/llm/client.ts 에서만 읽힌다
# (tests/api-key-boundary.test.ts 가 그것을 강제한다).
#
# 넣기 전에 OpenAI 대시보드에서 확인할 것:
#   - 자동 충전(auto recharge)이 꺼져 있는가  ← 되돌릴 수 없는 유일한 설정 실수다
#   - Organization spend limit 이 걸려 있는가
OPENAI_API_KEY=
